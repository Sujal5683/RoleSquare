// Workspace Intelligence Platform — Prisma Schema
// Multi-tenant, AI-native SaaS for converting Google Workspace content into
// structured, evidence-backed datasets through schema-driven AI extraction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Identity & Organization
// ────────────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  avatarUrl         String?
  role              String   @default("user") // global role: user | admin
  plan              String   @default("free") // user's billing plan
  notificationPrefs String   @default("{}") // JSON
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizations       OrganizationMember[]
  connections         GoogleConnection[]
  sources             Source[]
  schemas             Schema[]
  datasets            Dataset[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  sharingReqs         SharingRequest[]     @relation("SharingRequester")
  approvedShares      SharingRequest[]     @relation("SharingDecider")
  importJobs          ImportJob[]
  jobs                AiJob[]
  sentInvitations     Invitation[]         @relation("SentInvitations")
  datasetAccessGrants DatasetAccess[]      @relation("GranteeUserAccess")
  assistantSessions   AssistantSession[]
  billedOrganizations Organization[]       @relation("OrgBillingUser")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free | team | enterprise
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  retentionEmails    String @default("90")
  retentionDocs      String @default("365")
  retentionAuditLogs String @default("365")
  exportFileExpiry   String @default("7d")

  members                OrganizationMember[]
  connections            GoogleConnection[]
  sources                Source[]
  schemas                Schema[]
  datasets               Dataset[]
  jobs                   AiJob[]
  auditLogs              AuditLog[]
  usageMetrics           UsageMetric[]
  sharingReqs            SharingRequest[]
  sharePerms             SharingPermission[]
  webhooks               Webhook[]
  apiKeys                ApiKey[]
  crossOrgPerms          CrossOrgPermission[]    @relation("OwnedCrossOrgPerms")
  invitations            Invitation[]
  ownedAccesses          DatasetAccess[]         @relation("OwnerOrgAccess")
  granteeOrgAccesses     DatasetAccess[]         @relation("GranteeOrgAccess")
  invoices               Invoice[]
  importJobs             ImportJob[]
  // Google Sheets Integration
  googleSheetsAccounts   GoogleSheetsAccount[]
  spreadsheetConnections SpreadsheetConnection[]
  sheetMappings          SheetMapping[]
  assistantSessions      AssistantSession[]
  billingUserId          String?
  billingUser            User?                   @relation("OrgBillingUser", fields: [billingUserId], references: [id])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | manager | member | viewer
  status         String   @default("active") // invited | active | removed
  invitedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Google Integration (simulated acquisition layer)
// ────────────────────────────────────────────────────────────────────────────

model GoogleConnection {
  id              String    @id @default(cuid())
  userId          String
  organizationId  String?
  googleEmail     String
  scopes          String    @default("gmail.readonly,drive.metadata.readonly")
  status          String    @default("active") // active | expired | revoked | degraded
  accessToken     String? // AES-256-GCM encrypted short-lived access token
  refreshToken    String? // AES-256-GCM encrypted long-lived refresh token
  tokenExpiresAt  DateTime? // when the access token expires
  watchExpiresAt  DateTime?
  watchExpirePref String    @default("yearly") // never | weekly | monthly | yearly
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sources      Source[]

  @@index([userId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// Sources, Rules, Runs
// ────────────────────────────────────────────────────────────────────────────

model Source {
  id                 String    @id @default(cuid())
  organizationId     String
  ownerUserId        String
  googleConnectionId String
  schemaId           String?
  datasetId          String?
  name               String
  description        String?
  sourceType         String    @default("gmail") // gmail | drive | docs | sheets | forms
  status             String    @default("active") // active | paused | idle | error
  runState           String    @default("idle") // idle | scanning | parsing | extracting | validating
  scheduleMode       String    @default("interval") // interval | cron | manual
  scheduleExpr       String    @default("6h")
  maxEmailsPerScan   Int       @default(100) // max emails to fetch per Gmail scan run
  config             String    @default("{}") // JSON: processing limits, depth, etc.
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User             @relation(fields: [ownerUserId], references: [id])
  googleConnection GoogleConnection @relation(fields: [googleConnectionId], references: [id])
  schema           Schema?          @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  dataset          Dataset?         @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  rules            SourceRule[]
  runs             SourceRun[]
  emails           Email[]

  @@index([organizationId])
  @@index([ownerUserId])
}

model SourceRule {
  id         String  @id @default(cuid())
  sourceId   String
  filterType String // sender | subject | body | date | attachment | link | drive_link
  operator   String // eq | contains | excludes | regex | domain | gt | lt | between | required
  value      String // JSON-encoded value (array, string, boolean, etc.)
  metadata   String? // JSON: { preset?, startDate?, endDate? } for date rules
  position   Int     @default(0)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model SourceRun {
  id           String    @id @default(cuid())
  sourceId     String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("running") // running | success | failed | partial
  mode         String    @default("incremental") // historical | incremental
  stats        String    @default("{}") // JSON: emailsMatched, attachmentsFound, etc.
  progress     Int       @default(0)
  errorMessage String?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Email Model
// ────────────────────────────────────────────────────────────────────────────

model Email {
  id               String   @id @default(cuid())
  sourceId         String
  googleMessageId  String
  threadId         String?
  fromAddress      String
  toAddress        String
  ccAddresses      String?
  subject          String
  snippet          String
  bodyText         String?
  bodyHtml         String?
  receivedAt       DateTime
  dedupHash        String
  processingStatus String   @default("pending") // pending | matched | parsed | extracted | rejected
  createdAt        DateTime @default(now())

  source      Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]
  links       EmailLink[]

  @@unique([sourceId, googleMessageId])
  @@index([sourceId])
  @@index([receivedAt])
}

model EmailAttachment {
  id          String  @id @default(cuid())
  emailId     String
  filename    String
  mimeType    String
  size        Int
  storagePath String?
  status      String  @default("discovered") // discovered | fetched | parsed | failed

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailLink {
  id           String  @id @default(cuid())
  emailId      String
  url          String
  resourceType String // drive | docs | sheets | forms | external
  resourceId   String?
  resolved     Boolean @default(false)

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

// ────────────────────────────────────────────────────────────────────────────
// Documents & RAG (chunking simulated)
// ────────────────────────────────────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  sourceType  String // email | attachment | drive | docs | sheets | forms
  sourceId    String
  name        String
  contentText String
  pageCount   Int      @default(1)
  status      String   @default("parsed") // fetched | parsed | chunked | indexed | failed
  createdAt   DateTime @default(now())

  chunks DocumentChunk[]

  @@index([sourceType, sourceId])
}

model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  tokenCount Int
  pageNumber Int    @default(1)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ────────────────────────────────────────────────────────────────────────────
// Schema-Driven Extraction
// ────────────────────────────────────────────────────────────────────────────

model Schema {
  id             String   @id @default(cuid())
  organizationId String
  createdBy      String
  name           String
  description    String?
  version        Int      @default(1)
  promptTemplate String?
  isDefault      Boolean  @default(false) // true = system-provisioned default email schema
  datasetType    String   @default("custom") // default | custom
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User          @relation(fields: [createdBy], references: [id])
  fields       SchemaField[]
  sources      Source[]
  datasets     Dataset[]

  @@index([organizationId])
}

model SchemaField {
  id                  String  @id @default(cuid())
  schemaId            String
  name                String
  type                String // text | number | date | boolean | enum | array | multiselect
  description         String?
  instructions        String?
  required            Boolean @default(false)
  options             String? // JSON array for enum/multiselect
  validation          String? // JSON: { min?: number, max?: number, regex?: string }
  position            Int     @default(0)
  confidenceThreshold Float   @default(0.7) // min confidence before routing to review (0..1)
  isHidden            Boolean @default(false) // if true, skip this field in deterministic sync output

  schema Schema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId])
}

// ────────────────────────────────────────────────────────────────────────────
// Datasets & Evidence-Backed Values
// ────────────────────────────────────────────────────────────────────────────

model Dataset {
  id             String   @id @default(cuid())
  organizationId String
  schemaId       String?
  createdBy      String
  name           String
  description    String?
  recordCount    Int      @default(0)
  isDefault      Boolean  @default(false) // true = system-provisioned default dataset
  datasetType    String   @default("custom") // default | custom
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schema          Schema?                @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  creator         User                   @relation(fields: [createdBy], references: [id])
  sources         Source[]
  records         DatasetRecord[]
  sharePerms      SharingPermission[]
  sharingReqs     SharingRequest[]
  crossOrgPerms   CrossOrgPermission[]
  importJobs      ImportJob[]
  datasetAccesses DatasetAccess[]
  // Google Sheets Integration
  sheetMappings   SheetMapping[]
  schemaVersions  DatasetSchemaVersion[]
  columnDefs      DatasetColumnDef[]
  rowExternalIds  DatasetRowExternalId[]

  @@index([organizationId])
}

model DatasetRecord {
  id            String   @id @default(cuid())
  datasetId     String
  sourceEmailId String?
  status        String   @default("valid") // valid | needs_review | rejected | approved | updated
  confidence    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataset Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  values  DatasetValue[]

  @@index([datasetId])
  @@index([status])
}

model DatasetValue {
  id                 String    @id @default(cuid())
  recordId           String
  fieldId            String
  value              String // JSON-encoded value
  originalValue      String? // Preserves the original AI-extracted value after human correction
  originalConfidence Float?
  confidence         Float     @default(0)
  evidence           String // evidence snippet text
  sourceFile         String?
  pageNumber         Int?
  chunkId            String?
  modelUsed          String    @default("gemini-1.5-pro")
  promptVersion      String    @default("v1")
  extractedAt        DateTime  @default(now())
  correctedAt        DateTime?
  correctedBy        String?

  record DatasetRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([fieldId])
}

// ────────────────────────────────────────────────────────────────────────────
// Jobs & AI Outputs
// ────────────────────────────────────────────────────────────────────────────

model AiJob {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  type           String // GMAIL_SCAN | DETERMINISTIC_SYNC | EMAIL_PARSE | ATTACHMENT_PROCESS | DRIVE_DISCOVERY | DOCUMENT_PARSE | AI_EXTRACTION | AI_VALIDATION | EXPORT
  status         String    @default("queued") // queued | running | success | failed | retry | dlq
  payload        String    @default("{}") // JSON
  agentKey       String? // extractor | analyst | validator | transformer | researcher | assistant
  attempts       Int       @default(0)
  progress       Int       @default(0)
  errorMessage   String?
  result         String? // JSON
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  outputs      AiOutput[]
  agentLogs    AgentLog[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model AiOutput {
  id               String   @id @default(cuid())
  jobId            String
  modelUsed        String
  promptHash       String
  rawResponse      String // JSON
  tokensUsed       Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0) // pre-computed at write time from model pricing
  createdAt        DateTime @default(now())

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ────────────────────────────────────────────────────────────────────────────
// Sharing & Governance
// ────────────────────────────────────────────────────────────────────────────

model SharingRequest {
  id                   String    @id @default(cuid())
  organizationId       String
  datasetId            String?
  requestedBy          String
  status               String    @default("pending") // pending | approved | rejected | revoked
  decidedBy            String?
  reason               String?
  level                String    @default("read") // read | comment | edit | admin
  fieldScope           String? // JSON
  rowFilter            String? // JSON
  targetOrganizationId String? // org being asked / org receiving the share
  targetUserId         String? // specific user (optional)
  targetEmail          String? // email-based lookup for user-to-user sharing
  direction            String    @default("outgoing") // outgoing | incoming
  shareType            String    @default("request") // request | grant
  createdAt            DateTime  @default(now())
  decidedAt            DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  requester    User         @relation("SharingRequester", fields: [requestedBy], references: [id])
  decider      User?        @relation("SharingDecider", fields: [decidedBy], references: [id])

  @@index([organizationId])
  @@index([targetOrganizationId])
  @@index([targetEmail])
  @@index([status])
}

model SharingPermission {
  id             String   @id @default(cuid())
  datasetId      String
  organizationId String
  level          String   @default("read")
  fieldScope     String? // JSON
  rowFilter      String? // JSON
  createdAt      DateTime @default(now())

  dataset      Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String   @default("user") // user | system | ai
  actorId        String?
  action         String // create | update | delete | scan | extract | approve | share | export
  entity         String // source | dataset | schema | record | connection | member | job
  entityId       String?
  before         String? // JSON
  after          String? // JSON
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([entity, entityId])
}

model UsageMetric {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  metricType     String // ai_tokens | emails_scanned | documents_parsed | exports | storage
  value          Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricType])
}

model Webhook {
  id               String    @id @default(cuid())
  organizationId   String
  url              String
  secret           String?
  events           String    @default("source.run_completed,extraction.completed,review.needed,job.failed") // comma-separated
  status           String    @default("active") // active | paused | failing
  lastTriggeredAt  DateTime?
  lastResponseCode Int?
  failureCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// Cross-Organisation Permissions
// ────────────────────────────────────────────────────────────────────────────

model CrossOrgPermission {
  id                  String   @id @default(cuid())
  datasetId           String
  ownerOrganizationId String
  granteeOrgId        String? // target org receiving access
  granteeUserId       String? // or specific user
  level               String   @default("read") // read | comment | edit
  fieldScope          String? // JSON
  rowFilter           String? // JSON
  status              String   @default("active") // active | revoked
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dataset           Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  ownerOrganization Organization @relation("OwnedCrossOrgPerms", fields: [ownerOrganizationId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([ownerOrganizationId])
  @@index([granteeOrgId])
}

// ────────────────────────────────────────────────────────────────────────────
// Unified Dataset Access — replaces the split SharingPermission / CrossOrgPermission
// approach. Supports: org-to-org, user-to-user, org-to-user sharing.
// ────────────────────────────────────────────────────────────────────────────

model DatasetAccess {
  id         String @id @default(cuid())
  datasetId  String
  ownerOrgId String // The org that owns the dataset and granted this access

  // Exactly one of these must be set (or both null for a pending request)
  granteeOrgId  String? // grant to an entire organization
  granteeUserId String? // grant to a specific user

  level           String  @default("read") // read | comment | edit
  fieldScope      String? // JSON: { include?: string[], exclude?: string[] }
  rowFilter       String? // JSON: arbitrary row-level filter
  status          String  @default("active") // active | revoked
  isPaused        Boolean @default(false)
  sourceRequestId String? // back-ref to the SharingRequest that created this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset     Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  ownerOrg    Organization  @relation("OwnerOrgAccess", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  granteeOrg  Organization? @relation("GranteeOrgAccess", fields: [granteeOrgId], references: [id], onDelete: Cascade)
  granteeUser User?         @relation("GranteeUserAccess", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([ownerOrgId])
  @@index([granteeOrgId])
  @@index([granteeUserId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Invitations — proper invite flow replacing the broken status="invited" hack.
// ────────────────────────────────────────────────────────────────────────────

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String // email of the invitee
  role           String    @default("member") // owner | admin | manager | member | viewer
  token          String    @unique @default(cuid()) // URL-safe accept token
  invitedBy      String
  status         String    @default("pending") // pending | accepted | expired | cancelled
  expiresAt      DateTime // default +7 days
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("SentInvitations", fields: [invitedBy], references: [id])

  @@unique([organizationId, email])
  @@index([token])
  @@index([email])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// Structured Agent Logs
// ────────────────────────────────────────────────────────────────────────────

model AgentLog {
  id             String   @id @default(cuid())
  jobId          String
  organizationId String
  agentKey       String // extractor | analyst | validator | transformer | researcher | assistant | system
  level          String   @default("info") // info | warn | error | debug
  message        String
  metadata       String? // JSON
  createdAt      DateTime @default(now())

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([organizationId, agentKey])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Google Sheets Integration
// Separate from the Gmail/Drive GoogleConnection — uses different scopes and
// can be a completely different Google account from the user's app login.
// ────────────────────────────────────────────────────────────────────────────

/// A Google account connected specifically for Sheets access.
/// Completely separate from GoogleConnection (which is for Gmail/Drive).
/// The user can connect work@company.com for Sheets while their app login
/// and Gmail connection uses personal@gmail.com.
model GoogleSheetsAccount {
  id             String    @id @default(cuid())
  organizationId String
  userId         String // the app user who connected it
  googleEmail    String
  displayName    String?
  avatarUrl      String?
  scopes         String    @default("spreadsheets,drive.readonly")
  status         String    @default("active") // active | expired | revoked | degraded
  accessToken    String? // AES-256-GCM encrypted short-lived token
  refreshToken   String? // AES-256-GCM encrypted long-lived token
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spreadsheetConnections SpreadsheetConnection[]
  importJobs             ImportJob[]

  @@unique([organizationId, googleEmail])
  @@index([organizationId])
  @@index([userId])
}

/// A specific Google Spreadsheet (Drive file) linked to the organization.
/// Multiple datasets can share the same spreadsheet via different tabs.
model SpreadsheetConnection {
  id              String   @id @default(cuid())
  organizationId  String
  sheetsAccountId String
  spreadsheetId   String // Google's unique spreadsheetId
  spreadsheetName String
  spreadsheetUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sheetsAccount GoogleSheetsAccount @relation(fields: [sheetsAccountId], references: [id], onDelete: Cascade)
  sheetMappings SheetMapping[]

  @@unique([organizationId, spreadsheetId])
  @@index([organizationId])
  @@index([sheetsAccountId])
}

/// A specific tab within a spreadsheet, linked to exactly one dataset.
/// The same spreadsheet can have multiple SheetMappings for different tabs.
model SheetMapping {
  id                      String   @id @default(cuid())
  organizationId          String
  datasetId               String
  spreadsheetConnectionId String
  sheetId                 Int // Google's numeric sheetId for protected ranges
  sheetName               String // tab name
  direction               String   @default("bidirectional") // to_sheet | from_sheet | bidirectional
  schemaFingerprint       String? // SHA256(columnId+name+order+type) — changes trigger mismatch
  rowIdColumnIndex        Int? // 0-based index of hidden row-ID column in sheet
  status                  String   @default("active") // active | paused | error | schema_mismatch | unlinked
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset               Dataset                @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  spreadsheetConnection SpreadsheetConnection  @relation(fields: [spreadsheetConnectionId], references: [id], onDelete: Cascade)
  syncState             SyncState?
  syncEvents            SyncEvent[]
  syncConflicts         SyncConflict[]
  rowExternalIds        DatasetRowExternalId[]

  @@index([organizationId])
  @@index([datasetId])
  @@index([spreadsheetConnectionId])
}

/// Schema version snapshot — created before every schema-changing operation.
/// Enables rollback to any previous version.
model DatasetSchemaVersion {
  id           String   @id @default(cuid())
  datasetId    String
  version      Int // monotonically increasing
  columns      String // JSON: DatasetColumnDef[] snapshot
  fingerprint  String // SHA256 of the serialized column set
  changedBy    String? // userId who approved the change
  changeSource String // user | sync | import | rollback | initial
  reason       String?
  createdAt    DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, version])
  @@index([datasetId])
}

/// Permanent column definition — the authoritative schema for a dataset.
/// Every column has a stable columnId that is never reused.
model DatasetColumnDef {
  id         String   @id @default(cuid())
  datasetId  String
  columnId   String // permanent stable identifier, e.g. "col_8f91a3..."
  name       String // display name
  dataType   String // text | number | integer | decimal | boolean | date | datetime | email | url | currency | enum
  position   Int // display/column order
  required   Boolean  @default(false)
  options    String? // JSON array — for enum type
  validation String? // JSON: { min?, max?, regex? }
  isDeleted  Boolean  @default(false) // soft-delete
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, columnId])
  @@index([datasetId])
}

/// Stable mapping between an application DatasetRecord and a Google Sheet row.
/// Uses a hidden app-controlled UUID column in the sheet, NOT the row number.
model DatasetRowExternalId {
  id             String    @id @default(cuid())
  datasetId      String
  recordId       String    @unique // DatasetRecord.id
  sheetMappingId String
  externalId     String // stable UUID stored in the sheet's hidden column
  sheetRowIndex  Int? // last known row number — informational only
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dataset      Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sheetMapping SheetMapping @relation(fields: [sheetMappingId], references: [id], onDelete: Cascade)

  @@unique([sheetMappingId, externalId])
  @@index([datasetId])
  @@index([sheetMappingId])
}

/// Current synchronization state and configuration for a SheetMapping.
model SyncState {
  id               String    @id @default(cuid())
  sheetMappingId   String    @unique
  enabled          Boolean   @default(true)
  conflictStrategy String    @default("flag") // flag | app_wins | sheet_wins
  scheduleMode     String    @default("interval") // interval | manual
  scheduleExpr     String    @default("5m")
  lastSyncAt       DateTime?
  lastSyncStatus   String? // success | partial | failed | schema_change
  lastSyncEventId  String?
  nextSyncAt       DateTime?
  syncedRows       Int       @default(0)
  errorCount       Int       @default(0)
  conflictCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sheetMapping SheetMapping @relation(fields: [sheetMappingId], references: [id], onDelete: Cascade)
}

/// Complete record of every sync run for a SheetMapping.
model SyncEvent {
  id             String    @id @default(cuid())
  sheetMappingId String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String // running | success | partial | failed | schema_change | conflict
  direction      String    @default("bidirectional")
  rowsAdded      Int       @default(0)
  rowsUpdated    Int       @default(0)
  rowsDeleted    Int       @default(0)
  conflicts      Int       @default(0)
  errors         Int       @default(0)
  schemaChanges  String? // JSON array of detected schema changes
  errorDetail    String?
  triggeredBy    String    @default("scheduler") // scheduler | manual | webhook | reconcile

  sheetMapping SheetMapping @relation(fields: [sheetMappingId], references: [id], onDelete: Cascade)

  @@index([sheetMappingId])
  @@index([status])
  @@index([startedAt])
}

/// Per-cell conflict detected when both the app and the sheet changed the same value.
/// Requires user resolution before sync can continue.
model SyncConflict {
  id              String    @id @default(cuid())
  sheetMappingId  String
  recordId        String // DatasetRecord.id
  columnId        String // DatasetColumnDef.columnId
  columnName      String // human-readable for display
  appValue        String? // JSON-encoded current app value
  sheetValue      String? // JSON-encoded current sheet value
  lastSyncedValue String? // JSON-encoded value at last successful sync
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String? // userId
  resolution      String? // keep_app | keep_sheet | manual
  status          String    @default("pending") // pending | resolved | auto_resolved

  sheetMapping SheetMapping @relation(fields: [sheetMappingId], references: [id], onDelete: Cascade)

  @@index([sheetMappingId, status])
  @@index([recordId])
}

/// An import operation from Google Sheets (one-time, not continuous sync).
model ImportJob {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  datasetId       String? // null if creating a new dataset during import
  newDatasetName  String?
  sheetsAccountId String
  spreadsheetId   String
  spreadsheetName String?
  sheetName       String
  importMode      String    @default("append") // append | update_existing | append_update | replace
  matchField      String? // columnId to match on for update_existing
  status          String    @default("pending") // pending | running | success | partial | failed
  totalRows       Int       @default(0)
  processedRows   Int       @default(0)
  insertedRows    Int       @default(0)
  updatedRows     Int       @default(0)
  skippedRows     Int       @default(0)
  errorRows       Int       @default(0)
  errors          String? // JSON: { row, message }[]
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  sheetsAccount GoogleSheetsAccount @relation(fields: [sheetsAccountId], references: [id], onDelete: Cascade)
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset       Dataset?            @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  mappings      ImportMapping[]

  @@index([organizationId])
  @@index([status])
}

/// Column-to-column mapping for a specific ImportJob.
model ImportMapping {
  id          String  @id @default(cuid())
  importJobId String
  sheetHeader String // Google Sheet column header
  columnId    String? // DatasetColumnDef.columnId — null = skip
  columnName  String? // resolved column name
  dataType    String? // resolved data type
  isNewColumn Boolean @default(false) // true = create new column on import
  confidence  Float   @default(0) // AI mapping confidence 0..1

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

// ----------------------------------------------------------------------------
// Billing & Invoices (Simulated)
// ----------------------------------------------------------------------------

model Invoice {
  id                 String   @id @default(cuid())
  organizationId     String
  planId             String
  amountUsd          Float
  status             String   @default("paid") // paid | pending | failed
  pdfUrl             String?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// AI Assistant — Chat Sessions & Messages
//
// Each user gets their own per-session history, scoped to both the user AND
// the organization (multi-tenant). Content is AES-256-GCM encrypted at the
// API layer before being written here — the DB never sees plaintext messages.
//
// Retention: sessions older than 7 days are soft-deleted via expiresAt.
// Lazy-deletion happens in the list route (sessions past expiresAt are excluded).
// ────────────────────────────────────────────────────────────────────────────

/// One conversation thread between a user and the AI assistant.
/// Scoped to a specific user + organization pair. Only the owning user
/// can read or write this session — enforced in every API route.
model AssistantSession {
  id             String    @id @default(cuid())
  /// The user who owns this session
  userId         String
  /// The organization context the session was started in
  organizationId String
  /// Display title auto-generated from the first user message (truncated, not encrypted)
  title          String    @default("New conversation")
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
  /// Hard expiry: sessions are excluded from lists after this point (7 days from creation)
  expiresAt      DateTime
  /// Soft-delete — set on explicit user delete, also set during pruning
  deletedAt      DateTime?
  /// Whether suggestion mode was active for this session
  suggestionMode Boolean   @default(false)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     AssistantMessage[]

  @@index([userId])
  @@index([organizationId])
  @@index([userId, organizationId])
  @@index([expiresAt])
}

/// A single message turn in an AssistantSession.
/// The `content` and `toolResult` fields hold AES-256-GCM ciphertext
/// (format: "<base64-ciphertext>:<base64-iv>") — never stored in plaintext.
model AssistantMessage {
  id         String   @id @default(cuid())
  sessionId  String
  /// "user" | "assistant"
  role       String
  /// AES-256-GCM encrypted message content (format: ciphertext:iv, both base64)
  content    String
  /// Tool name that was called for this turn (if any); stored unencrypted for audit
  toolName   String?
  /// AES-256-GCM encrypted JSON tool result blob (if any)
  toolResult String?
  /// Gemini model display name used for this assistant turn
  modelUsed  String?
  /// Undo token for reversing a completed write action (base64-JSON, time-limited)
  undoToken  String?
  /// Sequential position within the session — used for stable ordering
  position   Int
  createdAt  DateTime @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, position])
}

